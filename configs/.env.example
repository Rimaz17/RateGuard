# Copy to .env in the repository root (`make up` does this for you if .env is
# missing) and adjust. .env is gitignored. Every value here is a local placeholder.

# --- RateGuard service (read by the binary; RG_ prefix) ----------------------

# TCP address the HTTP server listens on when run on the host (`make run`).
# Inside Docker Compose it is fixed to :8080; see RATEGUARD_HOST_PORT below.
RG_HTTP_ADDR=:8080
# http.Server timeouts. All must be positive Go durations (e.g. 500ms, 10s, 2m).
RG_HTTP_READ_HEADER_TIMEOUT=5s
RG_HTTP_READ_TIMEOUT=10s
RG_HTTP_WRITE_TIMEOUT=10s
RG_HTTP_IDLE_TIMEOUT=120s
# How long in-flight requests get to finish after SIGINT/SIGTERM.
RG_SHUTDOWN_TIMEOUT=15s
# debug | info | warn | error
RG_LOG_LEVEL=info

# PostgreSQL connection string (postgres:// URL or libpq key=value). Required.
# This value is for `make run` against the compose stack; inside Docker Compose
# it is built from the POSTGRES_* values below instead.
RG_DATABASE_URL=postgres://rateguard:change-me-local-only@127.0.0.1:5433/rateguard?sslmode=disable
# Connection pool limits. MAX_CONNS must be at least 1; durations must be positive.
RG_DATABASE_MAX_CONNS=10
RG_DATABASE_MAX_CONN_LIFETIME=30m
RG_DATABASE_MAX_CONN_IDLE_TIME=5m

# Redis URL (redis:// or rediss://). For `make run`; Docker Compose points the
# service at its own redis container instead.
RG_REDIS_URL=redis://127.0.0.1:6379/0
# Longest a bucket operation in Redis may take before it counts as a failure.
RG_REDIS_TIMEOUT=100ms
# What decisions do while Redis is unreachable (ADR 0001, ADR 0014):
#   local   an in-memory bucket per instance, sized capacity / RG_INSTANCE_COUNT
#   open    allow every request
#   closed  refuse every request
RG_REDIS_FAILURE_MODE=local
# Consecutive failed bucket operations that open the circuit breaker (at least 1),
# and how long it stays open before one request probes Redis again.
RG_REDIS_BREAKER_FAILURES=5
RG_REDIS_BREAKER_COOLDOWN=5s
# An absolute path to also serve HTTP on as a Unix socket, for sidecar deployment
# (ADR 0017); empty serves TCP only. Whoever can connect is trusted to set
# X-Forwarded-For, so keep the mode tight: octal, owner and group by default.
RG_UNIX_SOCKET=
RG_UNIX_SOCKET_MODE=0660
# How many RateGuard instances share the traffic (at least 1). Only used to size
# the local buckets while Redis is down; keep it in step with the deployment.
RG_INSTANCE_COUNT=1

# Usage analytics (ADR 0018): how often each instance adds the checks it has
# counted into Redis (about how much usage a crashed instance loses), and how
# often an instance moves the counts from Redis into Postgres. Reports lag real
# time by about both together. Positive Go durations.
RG_USAGE_FLUSH_INTERVAL=1s
RG_USAGE_ROLLUP_INTERVAL=10s

# Per-dependency timeout for the /readyz checks.
RG_READINESS_TIMEOUT=2s

# Bearer token for the admin API (/v1/clients). Required, at least 32
# characters. This placeholder is for local use only: for anything real,
# generate one with `openssl rand -hex 32`.
RG_ADMIN_TOKEN=change-me-local-only-admin-token-0000

# Comma-separated CIDRs of load balancers or proxies whose X-Forwarded-For
# header is trusted when a caller without an API key is identified by IP.
# Leave empty unless RateGuard sits behind such a proxy: the header is
# otherwise client-controlled. Example: 10.0.0.0/8,192.168.1.7/32
RG_TRUSTED_PROXIES=

# --- Docker Compose only (not read by the binary) ---------------------------

# Host ports. Postgres defaults to 5433 to avoid clashing with a locally
# installed Postgres on 5432.
RATEGUARD_HOST_PORT=8080
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
# Swagger UI, started by `make docs`.
SWAGGER_UI_HOST_PORT=8081

# Local-only database credentials. Placeholders: never reuse them anywhere real.
# They are spliced into a URL, so keep the password URL-safe (no @ : / ? #).
POSTGRES_USER=rateguard
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=rateguard
