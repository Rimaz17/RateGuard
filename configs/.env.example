# Copy to .env in the repository root (`make up` does this for you if .env is
# missing) and adjust. .env is gitignored. Every value here is a local placeholder.

# --- RateGuard service (read by the binary; RG_ prefix) ----------------------

# TCP address the HTTP server listens on when run on the host (`make run`).
# Inside Docker Compose it is fixed to :8080; see RATEGUARD_HOST_PORT below.
RG_HTTP_ADDR=:8080
# http.Server timeouts. All must be positive Go durations (e.g. 500ms, 10s, 2m).
RG_HTTP_READ_HEADER_TIMEOUT=5s
RG_HTTP_READ_TIMEOUT=10s
RG_HTTP_WRITE_TIMEOUT=10s
RG_HTTP_IDLE_TIMEOUT=120s
# How long in-flight requests get to finish after SIGINT/SIGTERM.
RG_SHUTDOWN_TIMEOUT=15s
# debug | info | warn | error
RG_LOG_LEVEL=info

# --- Docker Compose only (not read by the binary) ---------------------------

# Host ports. Postgres defaults to 5433 to avoid clashing with a locally
# installed Postgres on 5432.
RATEGUARD_HOST_PORT=8080
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379

# Local-only database credentials. Placeholders: never reuse them anywhere real.
POSTGRES_USER=rateguard
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=rateguard
